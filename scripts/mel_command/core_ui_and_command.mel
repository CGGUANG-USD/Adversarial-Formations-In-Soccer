
global int $exchangeState = 0; 

// ==========================================

// ==========================================
global proc CC_refreshLayerUI(string $prefix) {
    string $numSlider = ($prefix + "NumSlider");
    string $container = ($prefix + "ScrollLayout");
    
    if (!`intSliderGrp -exists $numSlider`) return;
    if (!`columnLayout -exists $container`) return;
    
    int $target = `intSliderGrp -q -v $numSlider`;
    string $children[] = `columnLayout -q -childArray $container`;
    int $current = size($children);
    
    if ($target > $current) {
        setParent $container;
        for ($i = $current + 1; $i <= $target; $i++) {
            intSliderGrp -label ("layer" + $i + "_count") -field true -minValue 1 -maxValue 10 -value 1 -columnWidth3 75 35 70 -adjustableColumn 3 ($prefix + "LayerCount_" + $i);
        }
    }
    else if ($target < $current) {
        for ($i = $current; $i > $target; $i--) {
            string $ui = ($prefix + "LayerCount_" + $i);
            if (`intSliderGrp -exists $ui`) {
                deleteUI $ui;
            }
        }
    }
}

// ==========================================

// ==========================================
global proc CC_onExchangeToggle() {
    global int $exchangeState;
   
    $exchangeState = $exchangeState == 0 ? 1 : 0;
    print("// Exchange 状态已切换为: " + $exchangeState + "\n");
    CC_onGenerate();
}

// ==========================================

// ==========================================
global proc CC_onGenerate() {
    global int $exchangeState;
    
    string $selectedItems[] = `textScrollList -q -selectItem fuckerTeamList`;
    string $fuckerTeam = (size($selectedItems) > 0) ? $selectedItems[0] : "xiangyang";
    
  
    float $pene = `floatSliderGrp -q -v CC_permeabilitySlider`;
    float $randomVal = `floatSliderGrp -q -v CC_randomSlider`;
    
  
    text -e -visible false -label "" CC_errorText;
    
    
    int $fuckerLayers = `intSliderGrp -q -v fucker_NumSlider`;
    int $fuckerCounts[];
    int $fuckerSum = 0;
    for ($i = 1; $i <= $fuckerLayers; $i++) {
        string $ctrl = ("fucker_LayerCount_" + $i);
        if (`intSliderGrp -exists $ctrl`) {
            int $val = `intSliderGrp -q -v $ctrl`;
            $fuckerCounts[size($fuckerCounts)] = $val;
            $fuckerSum += $val;
        }
    }
    if ($fuckerSum != 10) {
        text -e -visible true -label ("error: " + $fuckerTeam + " team's field player count not equals 10") CC_errorText;
        return;
    }
    
    
    int $fuckedLayers = `intSliderGrp -q -v fucked_NumSlider`;
    int $fuckedCounts[];
    int $fuckedSum = 0;
    for ($i = 1; $i <= $fuckedLayers; $i++) {
        string $ctrl = ("fucked_LayerCount_" + $i);
        if (`intSliderGrp -exists $ctrl`) {
            int $val = `intSliderGrp -q -v $ctrl`;
            $fuckedCounts[size($fuckedCounts)] = $val;
            $fuckedSum += $val;
        }
    }
    if ($fuckedSum != 10) {
        text -e -visible true -label "error: wuhan team's field player count not equals 10" CC_errorText;
        return;
    }
    
    float $half_length = 1120;
    float $half_width = 600;
    float $my_rand = $randomVal;
    string $olds[] =`ls -type transform "*_num*_2" "*_num*_3" "pinOutput*" "xy_GRP*" "wh_GRP*" "*parentConstraint*"`;
    if(size ($olds)>0) delete $olds;
    team_gen("xy",$fuckerCounts,$my_rand,$half_length,$half_width,$pene);
    team_gen("wh",$fuckedCounts,$my_rand,$half_length,$half_width,$pene);
    string $caches[] = `ls -type cacheFile "Boy_Parabole_AShapeCache*"`;
    for($c in $caches)
    {
         string $plug = ($c + ".time");
         string $src[] = `listConnections -s true -d false -p true $plug`;

        if (size($src) > 0)
        {
            disconnectAttr $src[0] $plug;
            print ("Disconnected: " + $src[0] + " -> " + $plug + "\n");
        }   
    }
    currentTime 2 -edit;
    refresh -force;
    currentTime 1 -edit;
    refresh -force;
    
}

